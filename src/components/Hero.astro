<script>
  const systemTime = document.querySelector<HTMLTimeElement>("#system-time");

  if (systemTime) {
    const bangkokFormatter = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Bangkok",
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hourCycle: "h23",
    });

    const updateSystemTime = () => {
      const now = new Date();
      const parts = Object.fromEntries(
        bangkokFormatter.formatToParts(now).map(({ type, value }) => [type, value]),
      );

      systemTime.dateTime = now.toISOString();
      systemTime.textContent = `${parts.day} ${parts.month} ${parts.year}, ${parts.hour}:${parts.minute}:${parts.second} ICT`;
    };

    updateSystemTime();
    window.setInterval(updateSystemTime, 1000);
  }
</script>
