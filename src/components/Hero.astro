---
import TerrainVisual from "./TerrainVisual.astro";
---

<section class="hero">

  <div class="hero-background-grid"></div>

  <div class="container hero-grid">

    <div class="hero-content">

      <div class="eyebrow reveal">
        <span class="status-dot"></span>
        TECHNOLOGY LEADERSHIP / TRANSFORMATION  / AUTOMATION
      </div>

      <h1 class="hero-title reveal">
        I <br class="desktop-only-break" />
        build <span>technology</span> that <br class="desktop-only-break" />
        powers <span>real-world </span><br class="desktop-only-break" />
        <span>business.</span>
      </h1>

       <p class="hero-description reveal">
        Architecting the digital backbone that powers modern commerce and data-driven growth.
      </p>

      

      <div class="hero-actions reveal">

        <a href="#work" class="button button-primary">
          Explore My Work
          <span>↗</span>
        </a>

        <a href="#contact" class="button button-secondary">
          Contact Me
        </a>

      </div>

    </div>


    <TerrainVisual className="hero-terrain reveal" />

  </div>

  <div class="scroll-indicator">
    <span></span>
    SCROLL TO EXPLORE
  </div>

</section>
