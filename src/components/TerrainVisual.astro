---
interface Props {
  fullscreen?: boolean;
  className?: string;
}

const { fullscreen = false, className = "" } = Astro.props;
---

<div
  class:list={["terrain-visual", fullscreen && "terrain-visual--fullscreen", className]}
  data-terrain
  aria-label="Interactive abstract terrain visualization"
>
  <canvas class="terrain-canvas" aria-label="3D terrain. Drag to rotate, scroll or pinch to zoom."></canvas>
  <div class="terrain-fallback" role="status">WebGL unavailable</div>
</div>

<script>
  import { initializeTerrain } from "../scripts/terrain.js";

  initializeTerrain();
</script>

<style>
  .terrain-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #080808;
    touch-action: none;
  }

  .terrain-visual--fullscreen {
    height: 100vh;
    height: 100dvh;
    aspect-ratio: auto;
  }

  .terrain-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    outline: none;
  }

  .terrain-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    color: #707070;
    font: 12px/1.5 system-ui, sans-serif;
    letter-spacing: .12em;
  }

  .terrain-visual.is-unavailable .terrain-fallback {
    display: flex;
  }
</style>
