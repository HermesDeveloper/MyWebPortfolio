---
import { Image } from "astro:assets";
import profileImage from "../assets/images/profile/profile-khanaphoz.jpg";
---

<section id="about" class="section about-section">

  <div class="container">

    <div class="about-grid">

      <figure class="about-portrait reveal">
        <Image
          src={profileImage}
          alt="Khanaphoz — Technology, Systems and Automation"
          width={800}
          height={1000}
          fit="cover"
          loading="lazy"
        />
      </figure>

      <div class="about-copy">

      <div class="about-title reveal">

        <span class="section-index">
          04 / ABOUT
        </span>

        <h2>
          Technology is not
          <span>the goal.</span>
        </h2>

      </div>


      <div class="about-content reveal">

        <p class="about-large">
          The goal is to build something that
          actually works.
        </p>

        <p>
          I enjoy working at the intersection of
          software, infrastructure, data and
          real-world operations.
        </p>

        <p>
          From web applications to payment systems,
          I focus on understanding how the pieces
          connect — and how to make the whole system
          more reliable.
        </p>

        <div class="about-principles">

          <div>
            <span>01</span>
            <strong>Understand</strong>
          </div>

          <div>
            <span>02</span>
            <strong>Build</strong>
          </div>

          <div>
            <span>03</span>
            <strong>Improve</strong>
          </div>

        </div>

      </div>

      </div>

    </div>

  </div>

</section>
