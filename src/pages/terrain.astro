---
import TerrainVisual from "../components/TerrainVisual.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <title>Terrain Study</title>
  </head>
  <body>
    <TerrainVisual fullscreen />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after { box-sizing: border-box; }

  html,
  body {
    width: 100%;
    height: 100%;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
    background: #080808;
  }
</style>
